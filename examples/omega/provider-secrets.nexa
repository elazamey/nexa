# NEXA Ω v1 — secrets stay in the vault.
#
#   node tools/nexa.mjs run examples/omega/provider-secrets.nexa --mission summarise
#
# The module never contains a key. `secrets.load` returns a *handle*, the handle is
# sealed (from then on it may only enter an instrument that declares `accepts_secret`),
# and the policy names the one provider allowed to receive it. The runtime attaches the
# credential inside the vault's own trust domain; the transcript records digests only.

nexa omega 1

policy secrets {
    allow secrets.load, model.invoke("gemini")
    allow secret -> provider.gemini
    deny secret -> network
    max_runtime 20s
    max_steps 16
}

provider gemini {
    secret vault://gemini
    strategy declared
    fallback local
    max_cost 5
}

agent summariser {
    role planning
    model provider.gemini
    allow secrets.load, model.invoke("gemini")
}

grant secrets.load {
    subject summariser
    ttl 2m
    max_calls 1
}

grant model.invoke {
    subject summariser
    scope "gemini"
    ttl 2m
    max_calls 1
}

mission summarise {
    goal "Summarise a document without ever exposing the provider credential"
    agent summariser

    plan { load seal invoke report }

    require capability model.invoke("gemini")

    let key: SecretString = secrets.load(name: "gemini")
    seal key

    do model.invoke(provider: "gemini", prompt: "summarise", secret_handle: key) as answer

    emit answer
}
