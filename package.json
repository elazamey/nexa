{
  "name": "nexa",
  "version": "0.1.0",
  "description": "NEXA v0.1 - signed, capability-gated protocol for agent tooling. Default-deny, evidence-first, zero runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "scripts": {
    "test": "node --test",
    "audit": "node --test tests/security.test.js",
    "posture": "node tools/check-posture.mjs",
    "proof:permission": "node --permission --allow-fs-read=. tools/permission-proof.mjs",
    "proof:permission:legacy": "node --experimental-permission --allow-fs-read=. tools/permission-proof.mjs",
    "proof:permission:probe": "node tools/permission-probe.mjs --json",
    "proof:permission:auto": "node tools/permission-probe.mjs --run-proof",
    "preview:baseline": "node tools/preview-baseline.mjs",
    "demo": "node tools/demo.mjs",
    "demo:omega": "node tools/omega-demo.mjs",
    "demo:cellular": "node tools/cellular-demo.mjs",
    "attacks": "node tools/omega-attacks.mjs",
    "attacks:google": "node tools/google-attacks.mjs",
    "report": "node tools/gate-report.mjs",
    "report:json": "node tools/gate-report.mjs --json",
    "vectors": "node tools/vectors.mjs && node tools/omega-vectors.mjs && node tools/cellular-vectors.mjs && node tools/google-vectors.mjs",
    "metrics": "node tools/check-metrics.mjs",
    "verify": "npm run posture && npm test && npm run audit && npm run demo && npm run demo:omega && npm run demo:cellular && npm run attacks && npm run report",
    "dashboard": "node tools/celia-dashboard-server.mjs",
    "learning": "node tools/celia-learning.mjs",
    "dashboard:dev": "cd dashboard && npm install && npm run dev",
    "demo:celia": "node tools/celia-demo.mjs",
    "celia:vectors": "node tools/permission-probe.mjs --security"
  },
  "keywords": [
    "protocol",
    "capabilities",
    "ed25519",
    "evidence",
    "policy",
    "mcp",
    "agent"
  ]
}