# NEXA Ω v1 — a module the compiler refuses, with every reason at once.
#
#   node tools/nexa.mjs check examples/omega/refused-secret-egress.nexa
#
# Three independent failures, reported together rather than one at a time:
#   1. a secret reaches `emit`            → OMEGA_E_SECRET_EGRESS
#   2. unverified data becomes evidence   → OMEGA_E_EVIDENCE_UNTRUSTED
#   3. an agent calls outside its allow   → OMEGA_E_CAP_MISSING
# The module never runs: proof-carrying means refused-before-loaded.

nexa omega 1

policy project {
    allow secrets.load, echo.call
    max_runtime 10s
}

instrument echo {
    resource "tool:echo"
    actions call
}

agent careless {
    role implementation
    model provider.auto
    allow secrets.load, echo.call
}

grant secrets.load {
    subject careless
    ttl 1m
    max_calls 1
}

grant echo.call {
    subject careless
    ttl 1m
    max_calls 1
}

mission leak {
    goal "Try to leak a secret and call outside the allow-list"
    agent careless

    plan { load leak }

    let key: SecretString = secrets.load(name: "gemini")
    do echo.call(text: "ok") as echoed

    evidence claim "this is proof" from echoed
    do fs.delete("/")

    emit key
}
